# ─────────────────────────────────────────────────────────
# Meta Ads Performance Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Google Sheet ID (found in the sheet URL between /d/ and /edit)
# Example URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
# Sheet ID would be:  1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
VITE_SHEET_ID=YOUR_SHEET_ID_HERE

# Sheet tab GID (0 = first tab, find it in the URL after #gid=)
VITE_SHEET_GID=0

# Auto-refresh interval in milliseconds (default: 5 minutes = 300000)
VITE_REFRESH_INTERVAL=300000
